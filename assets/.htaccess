# Styles and scripts use filemtime-versioned URLs, so they can be cached
# immutably. Keep webfonts and images on a long but refreshable cache window.
<IfModule mod_headers.c>
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(woff2|webp|avif|png|jpe?g)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>
